# Site (SITE_URL = sitemap/robots API; VITE_SITE_URL = canonical JSON-LD khi build)
SITE_URL=https://www.kientrucsaokhue.com
VITE_SITE_URL=https://www.kientrucsaokhue.com
BASE_PATH=/
NODE_ENV=development

# Supabase → Connect (replace [YOUR-PASSWORD])
# Vercel / runtime API: transaction pooler 6543 (+ pgbouncer=true)
DATABASE_URL=postgresql://postgres.ltguwdkijlwijoesujet:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Local migrate (db push) + seed: session pooler 5432 — do NOT use on Vercel runtime
DIRECT_URL=postgresql://postgres.ltguwdkijlwijoesujet:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase Storage (Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Admin CMS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_USER_IDS=render-admin

# CORS (production)
CORS_ORIGINS=https://kientrucsaokhue.com,https://www.kientrucsaokhue.com

# Optional Replit OIDC (leave empty to use password login)
REPL_ID=

# Google Analytics 4 — dashboard admin (Property ID số, không phải G-xxx)
# Service account cần quyền Viewer trên property GA4
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Ads conversion (frontend) — AW-… + labels từ Ads → Chuyển đổi
# Bỏ trống labels nếu chỉ import event GA4 (generate_lead, click_call, click_zalo)
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONV_LEAD=
VITE_GOOGLE_ADS_CONV_CALL=
VITE_GOOGLE_ADS_CONV_ZALO=

# Tự động gửi lập chỉ mục sau seed/build (IndexNow + Google Indexing API + ping sitemap)
AUTO_SUBMIT_INDEXING=false
# Batch slug gửi IndexNow/Google sau seed: 7 | 8 | 9
INDEXING_BATCH=9
# IndexNow — key công khai; file public/{key}.txt phải chứa đúng key
INDEXNOW_KEY=d6b59758596746ba5add4f9bc6f1eab0
# Giới hạn URL gửi Google Indexing API mỗi lần (quota ~200/ngày)
INDEXING_GOOGLE_LIMIT=100
