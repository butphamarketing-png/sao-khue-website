{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --ignore-scripts",
  "buildCommand": "pnpm --filter @workspace/api-server run vercel-build",
  "outputDirectory": "artifacts/api-server/public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "framework": null
}
