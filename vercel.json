{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --ignore-scripts --no-frozen-lockfile",
  "buildCommand": "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/sao-khue run build && cp -r artifacts/sao-khue/dist/public/. artifacts/api-server/public/ && pnpm --filter @workspace/api-server run vercel-build",
  "outputDirectory": "artifacts/api-server/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots.txt"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed.xml"
    }
  ],
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kientrucsaokhue.com"
        }
      ],
      "destination": "https://www.kientrucsaokhue.com/:path*",
      "permanent": true
    },
    {
      "source": "/gioi-thieu/:path*",
      "destination": "/bai-viet/:path*",
      "permanent": true
    },
    {
      "source": "/kinh-nghiem-xay-dung/:path*",
      "destination": "/tin-tuc/:path*",
      "permanent": true
    },
    {
      "source": "/kinh-nghiem/:path*",
      "destination": "/tin-tuc/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.+)/",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "bulkRedirectsPath": "artifacts/api-server/bulk-redirects.json"
}
