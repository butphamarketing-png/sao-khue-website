{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --ignore-scripts --no-frozen-lockfile",
  "buildCommand": "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/sao-khue run build && cp -r artifacts/sao-khue/dist/public/. artifacts/api-server/public/ && pnpm --filter @workspace/api-server run vercel-build",
  "outputDirectory": "artifacts/api-server/public",
  "functions": {
    "artifacts/api-server/api/index.mjs": {
      "excludeFiles": "{artifacts/api-server/public/**,artifacts/sao-khue/**,artifacts/mockup-sandbox/**,artifacts/api-server/scripts/**,artifacts/api-server/src/**,artifacts/api-server/**/*.map}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed.xml"
    },
    {
      "source": "/xay-nha",
      "destination": "/index.html"
    },
    {
      "source": "/cai-tao-nha",
      "destination": "/index.html"
    },
    {
      "source": "/xay-moi",
      "destination": "/index.html"
    },
    {
      "source": "/thiet-ke",
      "destination": "/index.html"
    }
  ],
  "framework": null,
  "redirects": []
}
