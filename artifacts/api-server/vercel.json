{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --ignore-scripts --no-frozen-lockfile",
  "buildCommand": "cd ../.. && PORT=5173 BASE_PATH=/ pnpm --filter @workspace/sao-khue run build && cp -r artifacts/sao-khue/dist/public/. artifacts/api-server/public/ && cd artifacts/api-server && node build.mjs --no-sourcemap",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "excludeFiles": "{public/**,../sao-khue/**,../mockup-sandbox/**,scripts/**,src/**,**/*.map}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed.xml"
    }
  ],
  "framework": null,
  "redirects": []
}
