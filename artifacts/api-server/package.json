{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set NODE_ENV=development&& set PORT=8080&& pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "vercel-build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed-posts": "tsx scripts/seed-posts.ts",
    "export-seed-sql": "tsx scripts/export-seed-sql.ts",
    "export-seed-sql-batches": "tsx scripts/export-seed-sql-batches.ts",
    "seed-site-settings": "tsx scripts/seed-site-settings.ts",
    "verify-posts": "tsx scripts/verify-posts.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/seed-content": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "multer": "^1.4.5-lts.2",
    "openid-client": "^6.8.3",
    "pino": "^9",
    "pino-http": "^10",
    "sharp": "^0.34.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
